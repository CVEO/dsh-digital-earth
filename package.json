{
  "name": "@cveo/dsh-digital-earth",
  "version": "1.5.1",
  "type": "module",
  "description": "数字地球：在 CesiumJS 地球上叠加 3D Tiles / 3DGS 图层，与对话同屏并由 Agent 读写场景（earth_scene / earth_capture / earth_draw / earth_measure / earth_analyze / earth_shader）；支持地形分析、着色器预设、数据体检、Agent 标注与量测、/earth 命令、问 Agent 场景注入、HTML/Markdown 报告导出与按会话场景恢复，双语、浅深主题、自管影像 / 地形数据源与坐标 HUD",
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "digital-earth",
    "globe",
    "3d-tiles",
    "3dgs",
    "gaussian-splatting",
    "cesium",
    "webgis",
    "agent-tools",
    "geojson",
    "measurement"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/host",
    "src/client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/readme",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "preview.png",
    "CHANGELOG.md",
    "NOTICE",
    "vendor/cesium"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "build:client": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check client.js && npm run build:client -- --check && node scripts/check-size.mjs && node --test",
    "release:check": "node scripts/release-check.mjs",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": "CVEO Research Group, Wuhan University (https://www.whu-cveo.com/)",
  "homepage": "https://github.com/CVEO/dsh-digital-earth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CVEO/dsh-digital-earth.git"
  },
  "bugs": {
    "url": "https://github.com/CVEO/dsh-digital-earth/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
